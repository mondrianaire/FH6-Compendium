//------------------------------------------------
//--- 010 Editor Binary Template
//
//      File: fh6_cryptocontainer.bt
//   Authors: FH6 Tuning Lab
//   Version: 1.0 (2026-09-18)
//   Purpose: Forza CryptoContainer -- the envelope around C_ProfileData and gamedbRC.slt
//  Category: Game
// File Mask: C_ProfileData,*.slt
//
// THIS TEMPLATE DESCRIBES THE ENVELOPE, NOT THE CONTENTS. Everything after the
// 36-byte header is AES-256-CBC ciphertext. 010 Editor will show you the
// framing -- IV, header word, nonce, and the slot grid -- which is enough to
// identify a container, confirm its chunk size and spot a truncated file. It
// cannot show you the plaintext. For that:
//
//     scripts/tools/fh6_local_decrypt/     offline, read-only, no network
//
// WHAT IS SECRET, AND WHAT IS NOT. The algorithm is entirely public -- ordinary
// AES-256-CBC with a deterministic HKDF IV chain. It is NOT white-box crypto.
// The only withheld material is a handful of key BYTES, which on this machine
// live in FH6LocalCrypto.Runtime.dll (gitignored, NEVER committed). That is the
// whole reason a local decrypt was possible at all.
// Background: docs/fh6-profile-crypto-mimicry.md
//
// C:\XboxGames IS READ-ONLY. Always decrypt a COPY. Delete the plaintext when
// finished -- the profile carries the account XUID and the whole career.
//
// LAYOUT
//     0x00  16 bytes  IV0, the seed of the IV chain
//     0x10   4 bytes  header word -- MEANING UNKNOWN (see below)
//     0x14  16 bytes  nonce
//     0x24  N x slot, slot = chunkSize + 16-byte MAC
//
// THE IV CHAIN
//     NextIv(iv) = HKDF-SHA256(ikm=iv, len=16, salt=TransportKey1, info=TransportKey2)
// It advances TWICE per slot: once after the data block, once after the MAC
// block. Each IV depends only on the PREVIOUS IV and never on the data, so the
// entire chain is reproducible from IV0 alone -- which is what makes a
// streaming decrypt possible without touching the MACs.
//
// THE MACS ARE NOT VERIFIED ON READ. Neither ForzaCryptoTool nor our own
// decryptor checks them. A wrong key or a wrong chunk size therefore produces
// GARBAGE SILENTLY -- no exception, no signal. Validate the plaintext instead
// (zlib magic for the profile, "SQLite format 3" for the game DB).
//
// CHUNK SIZE IS PER CONTAINER TYPE AND CANNOT BE INFERRED FROM THE FILE SIZE.
// MEASURED, and this is the trap: gamedbRC.slt (15,861,684 bytes, payload
// 15,861,648) divides evenly by BOTH slot sizes --
//     128 KB slots: 15,861,648 / 131,088 = 121     <- correct
//     512 B  slots: 15,861,648 /     528 = 30,041  <- also exact, and wrong
// Divisibility proves nothing. Choose the chunk by container type, never by
// arithmetic, or you get 15 MB of silent noise.
//
// CORPUS: measured 2026-09-18 over every container on this machine -- 2 copies
// of C_ProfileData and 1 gamedbRC.slt. Three files is a small corpus; treat the
// per-type constants below as observed, not as established invariants.
//------------------------------------------------

BigEndian();   // only for the SQLite page geometry at the end; the container
LittleEndian();// itself is little-endian. Set explicitly at each read below.

// Choose before running. There is no reliable autodetect -- see above.
//   0 = C_ProfileData   (512-byte chunks)
//   1 = gamedbRC.slt    (131072-byte chunks)
local int CONTAINER_TYPE = 0;
local int CHUNK = (CONTAINER_TYPE == 1) ? 131072 : 512;

//------------------------------------------------ 0x00  header
typedef struct {
    ubyte IV0[16] <comment="seed of the HKDF IV chain; the whole chain derives from this">;

    // MEANING UNKNOWN. Two container types, two different values, n=1 each:
    //     C_ProfileData  3b 00 00 00   (LE u32 = 59)
    //     gamedbRC.slt   00 3c 01 00   (LE u32 = 80,896)
    // It is not a length: neither value relates to its file's size, slot count
    // or plaintext size by any factor found so far. Our decryptor reads past it
    // without using it, and decrypts correctly -- so whatever it carries, it is
    // not needed to decrypt. Recorded verbatim rather than guessed at. Do not
    // write a meaning into this field without a third container to test on.
    uint  HeaderWord <comment="UNKNOWN. profile=0x0000003B, gamedb=0x00013C00">;

    ubyte Nonce[16] <comment="differs per file; not part of the IV chain">;
} ContainerHeader <comment="36 bytes">;

//------------------------------------------------ 0x24  slots
// Each slot is chunkSize of AES-256-CBC ciphertext followed by a 16-byte MAC.
// The MAC block is skipped on read, but it still advances the IV chain.
typedef struct {
    ubyte Ciphertext[CHUNK] <comment="AES-256-CBC, PaddingMode.None">;
    ubyte Mac[16]           <comment="NOT verified on read; still advances the IV chain">;
} Slot <optimize=false>;

//------------------------------------------------ file
struct FH6_CRYPTO_CONTAINER {
    ContainerHeader header;
    local int64 payload = FileSize() - 36;
    local int   slotsz  = CHUNK + 16;
    local int64 n       = payload / slotsz;
    if ( payload > 0 && payload % slotsz == 0 )
        Slot slots[n] <optimize=false>;
    else
        ubyte payload_unslotted[payload] <comment="does not divide into slots -- wrong CONTAINER_TYPE, or truncated">;
} file;

// ---- after decryption, the plaintext is NOT the final artifact --------------
//
// C_ProfileData  container -> [u32 compressedSize][u32 inflatedSize] then a
//                zlib stream of exactly compressedSize bytes, which MUST inflate
//                to exactly inflatedSize (our decryptor treats any other length
//                as a hard error). Inside sits the save payload, including an
//                embedded SQLite image -- the Career_Garage database.
//                Structure: docs/format-c-profiledata.md
//                Fields:    docs/format-c-profiledata-fields.md
//
// gamedbRC.slt   container -> XOR with a CRC32-derived page keystream. The
//                keystream is SELF-INVERSE, so the same routine scrambles and
//                unscrambles. The game folds bytes through ASCII tolower before
//                the CRC step. Then TRIM: the container pads out to a 128 KB
//                boundary, so the image carries trailing pages the database
//                does not own. The SQLite header's own geometry gives the
//                logical length --
//                    page_size  = u16 BIG-endian at offset 16 (1 encodes 65536)
//                    page_count = u32 BIG-endian at offset 28
//                    logical    = page_size * page_count
//                Trimming to that makes our output byte-identical to
//                ForzaCryptoTool's. SQLite opens the untrimmed image too, which
//                is exactly why this step is easy to skip and hard to notice.
//
// ---- assertions -------------------------------------------------------------
if ( FileSize() < 36 )
    Warning( "Too small to be a CryptoContainer: %Lu bytes", FileSize() );
else if ( (FileSize() - 36) % 16 != 0 )
    Warning( "Payload is not AES block-aligned -- not a container, or truncated" );
