//------------------------------------------------
//--- 010 Editor Binary Template
//
//      File: fh6_swatchbin.bt
//   Authors: FH6 Tuning Lab
//   Version: 1.0 (2026-09-18)
//   Purpose: Forza Horizon 6 UI texture -- .swatchbin ('burG' Grub bundle)
//  Category: Image
// File Mask: *.swatchbin
//
// SOURCE-CATEGORY: game install -- PLAIN DEFLATE ZIP, no decryption
// SOURCE-LOCATION: C:\XboxGames\Forza Horizon 6\Content\media\ui\textures\data_bound\Upgrade_Parts.zip -- 902 entries, 200x200 mostly
// SOURCE-LOCATION: C:\XboxGames\Forza Horizon 6\Content\media\ui\textures\hires\data_bound\Upgrade_Parts.zip -- 734 entries, 400x400
// SOURCE-READ: plain zip; each entry is a 'burG' bundle holding ONE BC7 image, one mip level.
// SOURCE-READ: BOTH variants verified 2026-09-18: 902/902 and 734/734 match the BC7 block count exactly.
// SOURCE-READ: the corpus figures elsewhere in this template are the STANDARD zip unless marked hires.
// SOURCE-READER: scripts/telemetry/fh6_swatchbin.py (decodes BC7 -> PNG, stdlib only)
//
// WHAT IT IS: a single BC7-compressed image in a minimal "Grub" bundle. These
// are the part tiles and thumbnails the Upgrade Shop draws, which is how the
// lab renders real part icons instead of placeholder art.
//
// Canonical reader: scripts/telemetry/fh6_swatchbin.py -- decodes BC7 to PNG
// with the standard library alone (struct, zlib, zipfile; no numpy, no PIL).
//
// PIXEL FORMAT: DXGI_FORMAT_BC7_UNORM. 16-byte 4x4 blocks, linear row-major,
// top-left block first, EXACTLY ONE MIP LEVEL -- no mip chain in any of the 902
// entries. Widths that are not a multiple of 4 pad up to the next block
// boundary (a 670-wide thumbnail physically carries 672 px), so always size the
// payload from the padded block count, never from the width alone.
//
// CORPUS: measured 2026-09-18 over all 902 entries of Upgrade_Parts.zip.
//   magic 'burG'                                   902/902
//   flags == 0x101, header size == 140             902/902
//   the size word equals the real file size        902/902
//   payload == ceil(w/4) * ceil(h/4) * 16          902/902   <- BC7, one mip, confirmed
//   the 12-word TXCH block is byte-identical in every file except w/h
//   dimensions seen: 200x200 (717), 916x458 (174), 152x152 (9), 304x304, 100x100
//------------------------------------------------

LittleEndian();

//------------------------------------------------ 0x00  bundle header
typedef struct {
    char  Magic[4]   <comment="'burG'">;
    uint  Flags      <comment="0x101 in every observed file">;
    uint  HeaderSize <comment="== payload offset; 140 in every observed file">;
    uint  TotalSize  <comment="== the real file size, 902/902">;
    uint  ChunkCount <comment="1">;
} GrubHeader <comment="0x00..0x13">;

//------------------------------------------------ 0x14  BCXT
typedef struct {
    char  Magic[4] <comment="'BCXT'">;
    uint  Version  <comment="0x10000">;
    uint  TxchOffset <comment="44">;
    uint  DataOffset;
    uint  DataSize;
    uint  DataSizeAgain <comment="same value repeated">;
} BcxtBlock <comment="0x14..0x2B">;

//------------------------------------------------ 0x2C  TXCH
// Twelve u32s. Ten are the same in all 902 files; only Width and Height vary.
// Constant tuple measured: (525696, 56, 80, 0, 0, 0, 16777216, W, H, 1,
// 0x06010001, 0). The constants are recorded but NOT named -- none of them has
// been decoded, and a guessed name outlives the guess.
typedef struct {
    char Magic[4] <comment="'HCXT'">;
    uint Const0   <comment="525696">;
    uint Const1   <comment="56">;
    uint Const2   <comment="80">;
    uint Zero3;
    uint Zero4;
    uint Zero5;
    uint Const6   <comment="16777216 = 0x01000000">;
    uint Width;
    uint Height;
    uint Const9   <comment="1 -- mip count? one mip is all that was ever seen">;
    uint Const10  <comment="0x06010001 -- likely a format id; UNDECODED">;
    uint Zero11;
} TxchBlock <comment="0x2C..0x8B">;

//------------------------------------------------ 0x8C  pixels
struct FH6_SWATCHBIN {
    GrubHeader grub;
    BcxtBlock  bcxt;
    TxchBlock  txch;

    local uint bw = (txch.Width  + 3) / 4;   // blocks across, padded
    local uint bh = (txch.Height + 3) / 4;   // blocks down, padded
    ubyte Pixels[ bw * bh * 16 ] <comment="BC7 4x4 blocks, 16 bytes each, row-major">;
} file;

// ---- assertions -------------------------------------------------------------
if ( file.grub.Magic != "burG" )
    Warning( "Not a Grub bundle: magic is '%s'", file.grub.Magic );
if ( file.grub.TotalSize != FileSize() )
    Warning( "Size word %u != actual size %Lu", file.grub.TotalSize, FileSize() );
if ( file.grub.HeaderSize != 140 )
    Warning( "Header size %u, expected 140 -- payload offset moved", file.grub.HeaderSize );
local int64 expect = (int64)((file.txch.Width + 3) / 4) * ((file.txch.Height + 3) / 4) * 16;
if ( FileSize() - file.grub.HeaderSize != expect )
    Warning( "Payload is %Lu bytes, BC7 at %ux%u needs %Ld -- a mip chain, or not BC7",
             FileSize() - file.grub.HeaderSize, file.txch.Width, file.txch.Height, expect );
