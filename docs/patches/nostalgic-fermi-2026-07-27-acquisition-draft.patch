diff --git a/dashboard/styles.css b/dashboard/styles.css
index 98034f1..e3a66fd 100644
--- a/dashboard/styles.css
+++ b/dashboard/styles.css
@@ -122,6 +122,34 @@ td.price { font-variant-numeric: tabular-nums; }
 .share code { color: var(--accent); font-weight: 700; }
 .why { color: var(--muted); font-size: 13px; line-height: 1.6; }
 
+/* ---- discipline sections (Recommend tab) ---- */
+.disc-section { margin-bottom: 30px; }
+.disc-head { margin: 22px 2px 12px; padding-bottom: 10px; border-bottom: 1px solid var(--line); }
+.disc-head h2 { margin: 0; font-size: 17px; }
+.disc-head .disc-focus { margin: 4px 0 0; color: var(--muted); font-size: 13px; line-height: 1.5; max-width: 880px; }
+
+/* ---- Get it (car modal) ---- */
+.get-row {
+  display: flex; align-items: center; justify-content: space-between; gap: 12px;
+  background: var(--bg3); padding: 10px 12px; border-radius: 8px; margin: 8px 0 4px;
+}
+.get-row .price { font-variant-numeric: tabular-nums; font-weight: 700; }
+.method-badge {
+  font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 20px; white-space: nowrap;
+  background: var(--bg3); color: var(--muted);
+}
+.method-badge.m-autoshow { background: rgba(0,210,122,.15); color: var(--accent); }
+.method-badge.m-car_pass { background: rgba(227,179,65,.15); color: var(--warn); }
+.method-badge.m-wheelspin { background: rgba(240,136,62,.15); color: #f0883e; }
+.method-badge.m-aftermarket { background: rgba(47,129,247,.15); color: var(--accent2); }
+.method-badge.m-journal, .method-badge.m-loyalty { background: rgba(0,210,122,.15); color: var(--accent); }
+.get-note { color: var(--warn); }
+.alt-list { list-style: none; margin: 6px 0 0; padding: 0; }
+.alt-list li {
+  display: flex; align-items: center; gap: 10px;
+  background: var(--bg3); border-radius: 8px; padding: 8px 12px; margin: 6px 0;
+}
+
 .foot { display: flex; justify-content: space-between; padding: 16px 24px; border-top: 1px solid var(--line); color: var(--muted); font-size: 12px; }
 .foot code { background: var(--bg2); padding: 2px 6px; border-radius: 4px; }
 .empty { text-align: center; color: var(--muted); padding: 40px; }
